[testcontainers.org 00:00:19.18] Execute "mongosh --quiet --eval const targetDb = db.getSiblingDB("migration_test_51e91533de454ecaa0f51fbd76631cb7");
function ensureCommandWorked(result, message) {
  if (!result || result.ok !== 1) {
    throw new Error(`${message}: ${EJSON.stringify(result)}`);
  }
}
function ensureCollection(name, validator) {
  const exists =
    targetDb.getCollectionInfos({ name }).length &gt; 0;
  const options = {
    validator,
    validationLevel: "strict",
    validationAction: "error"
  };
  if (exists) {
    ensureCommandWorked(
      targetDb.runCommand({
        collMod: name,
        ...options
      }),
      `Could not update validator for ${name}`
    );
    print(`Updated validator: ${name}`);
    return;
  }
  ensureCommandWorked(
    targetDb.createCollection(name, options),
    `Could not create collection ${name}`
  );
  print(`Created collection: ${name}`);
}
